# ── Common Ground configuration ─────────────────────────────────────────────
# Copy to .env and fill in what you have. Everything is optional:
# with no keys the game runs in Open map mode with the scripted Demo AI.

# Claude (AI locals, game master, mentor). Without it the game uses Demo AI.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# AI_MODE=auto            # auto | claude | demo

# Google Maps Platform — browser key (Maps JavaScript API).
# Restrict it by HTTP referrer in the Cloud console.
GOOGLE_MAPS_API_KEY=
# Map ID for vector maps + Advanced Markers (DEMO_MAP_ID works for testing).
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google Maps Platform — server key for Maps Experience agent tools
# (mapstools.googleapis.com, MCP). Restrict it by API, not by referrer.
# Grounds the AI in real places + live weather. Falls back to Wikipedia only.
GOOGLE_MAPS_SERVER_KEY=

# MAPS_MODE=auto          # auto | google | open
# PORT=8787
# ACCESS_CODE=            # optional passcode players must enter (classroom deployments)
# RATE_LIMIT_PER_10MIN=120   # AI requests per player per 10 min (a shared IP gets 10x)
# TRUST_PROXY=true            # behind a load balancer / PaaS proxy, so limits see real IPs
# APP_USER_AGENT="CommonGround/0.1 (contact: you@example.org)"   # sent to Wikipedia/Nominatim/Open-Meteo
