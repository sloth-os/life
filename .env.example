# ── Common Ground configuration ─────────────────────────────────────────────
# Copy to .env and fill in what you have. Everything is optional:
# with no keys the game runs in Open map mode with the scripted Demo AI.
#
# Everything below except the start-up settings at the end can also be set on the settings page
# (/#settings, behind the settings key). Values set there override this file; edits to either
# apply without a restart.

# The AI behind the locals, game master and mentor. Without one the game uses Demo AI.
# Claude:
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# …or any OpenAI-compatible API (OpenAI, a gateway, vLLM, Ollama…):
# AI_PROVIDER=openai      # auto | anthropic | openai | demo
# AI_MODEL=               # required for openai
# AI_BASE_URL=            # e.g. https://api.openai.com/v1 or http://localhost:11434/v1
# AI_API_KEY=
# OPENAI_JSON_MODE=json_schema   # json_schema | json_object | text (steps down automatically)
# AI_THINKING=auto        # auto (think only at high effort) | off | model (leave it to the model)
# AI_THINKING_STYLE=      # qwen (enable_thinking) | openai (reasoning_effort) | none; read from the model name if unset
# A different model for some tasks, on the same provider (AI_MODEL for the rest):
# AI_MODEL_EXPEDITION=  AI_MODEL_PERSONA=  AI_MODEL_SCENE=  AI_MODEL_TURN=  AI_MODEL_HINT=  AI_MODEL_DEBRIEF=  AI_MODEL_ASK=
# Effort per task (low | medium | high | xhigh | max; low for turns, hints and answers, medium for the rest):
# EFFORT_EXPEDITION=  EFFORT_PERSONA=  EFFORT_SCENE=  EFFORT_TURN=  EFFORT_HINT=  EFFORT_DEBRIEF=  EFFORT_ASK=
# Output caps per task on OpenAI-compatible servers, in tokens (0 = none; a task that thinks gets 16000 more):
# AI_MAX_TOKENS_EXPEDITION=6000  AI_MAX_TOKENS_PERSONA=3000  AI_MAX_TOKENS_SCENE=3000  AI_MAX_TOKENS_TURN=1200
# AI_MAX_TOKENS_HINT=600  AI_MAX_TOKENS_DEBRIEF=4000  AI_MAX_TOKENS_ASK=1200

# Voice mode: an OpenAI-compatible model that hears audio (Qwen-Omni, gpt-4o-audio…).
# Shares the AI_* endpoint and key unless you set its own. If it can speak too,
# locals use these voices (she/her first, then he/him); otherwise the browser's voices.
# VOICE_MODEL=
# A text-to-speech model on the speech endpoint (/audio/speech: tts-1, gpt-4o-mini-tts…) gives the
# locals their voices instead; OpenAI's speech models default to the voices coral,ash.
# VOICE_TTS_MODEL=
# VOICE_BASE_URL=
# VOICE_API_KEY=
# VOICE_VOICES=Cherry,Ethan
# VOICE=off               # turn voice mode off without removing the model

# Postcards, painted through mm-gateway (https://github.com/sloth-os/mm-gateway),
# which holds the image provider's key. `node scripts/mm-gateway.ts start` runs one
# from IMAGE_MODEL_TYPE, IMAGE_MODEL_BASE_URL, IMAGE_MODEL and IMAGE_MODEL_API_KEY.
# MM_GATEWAY_URL=http://127.0.0.1:8792   # what scripts/mm-gateway.ts start serves
# MM_GATEWAY_API_KEY=
# IMAGE_MODEL=            # pin a model; the gateway picks one otherwise
# IMAGE_SIZE=1536x1024
# POSTCARD_IMAGES=off     # turn postcards off without removing the gateway

# Google Maps Platform — browser key (Maps JavaScript API).
# Restrict it by HTTP referrer in the Cloud console.
GOOGLE_MAPS_API_KEY=
# Map ID for vector maps + Advanced Markers (DEMO_MAP_ID works for testing).
# GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Google Maps Platform — server key for Maps Experience agent tools
# (mapstools.googleapis.com, MCP). Restrict it by API, not by referrer.
# Grounds the AI in real places + live weather. Falls back to Wikipedia only.
GOOGLE_MAPS_SERVER_KEY=
# MAPS_WALKING_ROUTES=true    # walking times to each local (compute_routes, billed per route)

# MAPS_MODE=auto          # auto | google | open
# ACCESS_CODE=            # optional passcode players must enter (classroom deployments)
# CLASSROOM=off           # classroom mode is on by default
# RATE_LIMIT_PER_10MIN=120   # AI requests per player per 10 min (a shared IP gets 10x)
# TRUST_PROXY=true            # behind a load balancer / PaaS proxy, so limits see real IPs
# APP_USER_AGENT="CommonGround/0.3 (contact: you@example.org)"   # sent to Wikipedia/Nominatim/Open-Meteo
# WIKIPEDIA_LANG=en       # which Wikipedia grounds the places

# ── Start-up settings: read once, from the environment (the settings page only shows them) ──
# PORT=8787
# DATA_DIR=data           # settings.json and classes (/app/data in Docker)
# DATABASE_URL=           # Postgres for settings and classes, shared by several instances
# ADMIN_KEY=              # the settings page's key; without one the server makes one and prints it once
# SETTINGS_PAGE=off       # lock the configuration to the environment
