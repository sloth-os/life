{
  "name": "common-ground",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-native exploration game: travel the real world on Google Maps, meet AI locals grounded in real places, and practice social skills with mentor feedback.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node server/index.ts --dev",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop",
    "test:e2e:mobile": "playwright test --project=mobile"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
